# Build-time configuration (committed defaults).
# Override per build, e.g.: BASE_PATH=/mini-apps/open-for/ npm run build
# For machine-specific overrides, use a (gitignored) .env.local instead.

# Route the app is served from. Drives Vite base, the output dir (dist mirrors
# this path), in-app crosslinks, and the path portion of SEO URLs. Default: site root.
BASE_PATH=/

# Absolute origin used to build SEO tags (canonical, og:url, og:image, JSON-LD)
# and sitemap.xml <loc> entries.
SITE_URL=https://example.com
